# Copy this file to .env. The default is fully free and local: no API key is used.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Optional paid cloud provider. Use only if LLM_PROVIDER=grok.
XAI_API_KEY=
GROK_MODEL=grok-4.7
# Downloads once on first upload; embeddings then run on your CPU.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DATA_DIR=./data
